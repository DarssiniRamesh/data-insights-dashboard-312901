{"is_source_file": true, "format": "Python", "description": "This file defines the database initialization and connection management logic for the backend API. It handles database path resolution, connection setup, schema creation, seed data, and auxiliary utilities to ensure a robust, idempotent setup around an SQLite database, with specific focus on ensuring the 'users' table and a system user exist, along with defining a comprehensive schema for various aspects of the application such as data assets, audits, and workflows.", "external_files": ["services.auth", "../services/auth"], "external_methods": ["AuthService.hash_password"], "published": ["get_db_path", "get_connection", "close_connection", "db_status", "init_db", "seed_test_users"], "classes": [], "methods": [{"name": "str _default_db_path()", "description": "Computes a deterministic default database file path within the container root.", "scope": "", "scopeKind": ""}, {"name": "str _fallback_db_path()", "description": "Provides a writable fallback path in /tmp for the database file.", "scope": "", "scopeKind": ""}, {"name": "sqlite3.Connection _connect_sqlite(db_path: str)", "description": "Creates a SQLite connection with appropriate pragmas and row factory.", "scope": "", "scopeKind": ""}, {"name": "None _ensure_parent_dir(db_path: str)", "description": "Ensures that the parent directory for the database file exists.", "scope": "", "scopeKind": ""}, {"name": "None _ensure_system_user(conn: sqlite3.Connection)", "description": "Ensures that the special 'system' user exists in the users table, creating or updating as necessary.", "scope": "", "scopeKind": ""}, {"name": "str get_db_path()", "description": "Fetches the database path from environment variables or defaults to a deterministic location.", "scope": "", "scopeKind": ""}, {"name": "sqlite3.Connection get_connection()", "description": "Returns a singleton SQLite connection, initializing the database schema if necessary, and handles fallback in case