[flake8]
# CI was failing because flake8 was enforcing strict formatting on many existing
# files (E501/W291/W293/E203), and also previously scanned the virtualenv.
# For this project, lint should focus on correctness errors rather than
# formatting; we therefore ignore these formatting-focused codes.
max-line-length = 120

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    .eggs,
    *.egg-info

ignore =
    # line too long
    E501,
    # trailing whitespace
    W291,
    # blank line contains whitespace
    W293,
    # whitespace before ':'
    E203

per-file-ignores =
    __init__.py:F401
